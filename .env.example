# Copy this file to a private .env file and replace the example values.
# In deployment, set these as server environment variables.

# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
B2B_BASE_URL=http://localhost:3000/b2b
ADMIN_BASE_URL=http://localhost:3000/admin

# MongoDB
MONGODB_URI=mongodb://localhost:27017/my-app
MONGODB_DB_NAME=my-app

# Liara Object Storage
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_PUBLIC_BASE_URL=

# Auth: credentials for the website admin login only
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_SECRET=replace-with-a-separate-random-secret-of-at-least-16-characters
SUPER_ADMIN_PHONE=09360000000
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_PHONE=09360000000

# SMS: credentials for the Melipayamak panel only
SMS_PROVIDER=mock
MELIPAYAMAK_USERNAME=
# Set either MELIPAYAMAK_API_KEY or MELIPAYAMAK_PASSWORD; API key takes precedence.
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_OTP_MODE=otp
MELIPAYAMAK_FROM=
# Required only when MELIPAYAMAK_OTP_MODE=pattern.
MELIPAYAMAK_BODY_ID=

# Other integrations
PAYMENT_PROVIDER=manual
SHIPPING_PROVIDER=mock
CHAT_PROVIDER=mock
STORAGE_PROVIDER=mock
SEARCH_PROVIDER=memory
ANALYTICS_PROVIDER=mock
UFO_MOCK_DATA_DIR=

# Store settings seed
STORE_OWNER_NAME=Example Store
STORE_PHONE=09360000000
STORE_ADDRESS=Example address
STORE_TELEGRAM=https://t.me/example
