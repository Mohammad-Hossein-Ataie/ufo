# Core: npm scripts set development for dev, production for build/start.
# Production: NODE_ENV=production, APP_BASE_URL=https://ufopuff.com,
# B2B_BASE_URL=https://ufopuff.com/b2b, ADMIN_BASE_URL=https://ufopuff.com/admin.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
B2B_BASE_URL=http://localhost:3000/b2b
ADMIN_BASE_URL=http://localhost:3000/admin
# Enable ONLY when a private ingress overwrites Forwarded headers AND validates Host.
# APP_BASE_URL always wins; production ufopuff.com should leave this false.
TRUST_PROXY_HEADERS=false
# Temporary, sanitized Origin/Host diagnostics; disable after verification.
ORIGIN_DEBUG=false

# MongoDB (keep real credentials in .env only)
MONGODB_URI=mongodb://username:password@localhost:27017/ufo
MONGODB_DB_NAME=ufo

# Liara Object Storage (never commit real access keys)
LIARA_ENDPOINT=https://storage.example.com
LIARA_BUCKET_NAME=your-bucket-name
LIARA_ACCESS_KEY=replace-with-storage-access-key
LIARA_SECRET_KEY=replace-with-storage-secret-key
LIARA_PUBLIC_BASE_URL=https://cdn.example.com
# Comma-separated HTTPS hosts allowed only for migrating legacy product image URLs
PRODUCT_IMAGE_SOURCE_HOSTS=

# Auth
# Empty uses the local fallback only in development/test. Production startup fails
# unless this is a non-placeholder random secret with at least 32 characters.
SESSION_SECRET=
OTP_SECRET=replace-with-an-independent-long-random-secret
SUPER_ADMIN_PHONE=09360000000
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password
ADMIN_PHONE=09360000000

# Integrations
SMS_PROVIDER=mock
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_MODE=otp
MELIPAYAMAK_FROM=
MELIPAYAMAK_BODY_ID=
PAYMENT_PROVIDER=manual
SHIPPING_PROVIDER=mock
CHAT_PROVIDER=mock
STORAGE_PROVIDER=mock
SEARCH_PROVIDER=memory
ANALYTICS_PROVIDER=mock
UFO_MOCK_DATA_DIR=./mock-data

# Store settings seed
STORE_OWNER_NAME=نام صاحب فروشگاه
STORE_PHONE=09360000000
STORE_ADDRESS=تهران، آدرس نمونه فروشگاه
STORE_TELEGRAM=https://t.me/example
